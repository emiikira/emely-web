---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from './Base.astro';
import CtaBar from '../components/CtaBar.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { projects } from '../data/site';
import { getLang, path, useTranslations, type CaseSlug } from '../i18n';

interface Props {
  slug: CaseSlug;
  name: string;
  tagline: string;
  cover: ImageMetadata;
  /** Two or three sentences that tell the whole story at a glance. */
  description: string;
  brief: string;
  details: { label: string; value: string }[];
  /** Table of contents; each `id` must match a <CaseSection id>. */
  sections: { id: string; title: string }[];
  /** Short line under the cover, e.g. to say that product screens keep their original language. */
  note?: string;
}

const { slug, name, tagline, cover, description, brief, details, sections, note } = Astro.props;

const lang = getLang(Astro.currentLocale);
const t = useTranslations(lang);
const index = projects.findIndex((project) => project.slug === slug);
const next = projects[(index + 1) % projects.length];
---

<Base title={`${name}, ${t('case.titleSuffix')}`} description={`${tagline} ${description}`} image={cover}>
  <header class="case-hero brand-surface">
    <div class="brand-surface__tint" aria-hidden="true"></div>
    <div class="case-hero__shape" aria-hidden="true"></div>
    <div class="container case-hero__inner">
      <a class="case-hero__back" href={path('projects', lang)}>
        <ArrowIcon direction="left" />
        {t('case.back')}
      </a>
      <div class="glass case-hero__panel">
        <p class="eyebrow">{t('case.eyebrow')}</p>
        <h1 class="title-xl">{name}</h1>
        <p class="case-hero__tagline">{tagline}</p>
        <dl class="case-hero__meta">
          {
            details.map((detail) => (
              <div>
                <dt>{detail.label}</dt>
                <dd>{detail.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </header>

  <div class="container case-cover">
    <Image
      src={cover}
      alt={`${t('case.coverAlt')} ${name}`}
      widths={[640, 1024, 1600]}
      sizes="(max-width: 1440px) 92vw, 1200px"
      loading="eager"
    />
  </div>
  {note && <p class="container case-language">{note}</p>}

  <section class="container case-summary" aria-label={t('case.summary')}>
    <div class="panel case-summary__item">
      <h2>{t('case.description')}</h2>
      <p>{description}</p>
    </div>
    <div class="case-summary__item case-summary__item--brief brand-surface">
      <div class="brand-surface__tint" aria-hidden="true"></div>
      <h2>{t('case.brief')}</h2>
      <p>{brief}</p>
    </div>
  </section>

  <div class="container case-layout">
    <nav class="case-toc" aria-label={t('case.tocLabel')}>
      <p class="case-toc__title">{t('case.toc')}</p>
      <ol>
        {
          sections.map((section, i) => (
            <li>
              <a href={`#${section.id}`} data-toc-link={section.id}>
                <span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {section.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="case-body">
      <slot />
    </article>
  </div>

  {
    next && next.slug !== slug && (
      <nav class="case-next" aria-label={t('case.nextLabel')}>
        <a class="container case-next__link" href={path(`case-${next.slug}`, lang)}>
          <span class="case-next__label">{t('case.next')}</span>
          <span class="case-next__name">
            {next.name} <ArrowIcon />
          </span>
          <span class="case-next__summary">{next.summary[lang]}</span>
        </a>
      </nav>
    )
  }

  <CtaBar showProjects={false} />
</Base>

<script>
  // Highlight the table-of-contents entry for the section being read.
  const links = new Map(
    [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((link) => [link.dataset.tocLink, link]),
  );
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        links.forEach((link) => link.removeAttribute('aria-current'));
        links.get(entry.target.id)?.setAttribute('aria-current', 'true');
      });
    },
    { rootMargin: '-30% 0px -60% 0px' },
  );
  links.forEach((_, id) => {
    const section = id && document.getElementById(id);
    if (section) observer.observe(section);
  });
</script>

<style>
  /* Cabecera: same duotone and glass panel as the /proyectos banner */
  .case-hero {
    padding-block: 32px 200px;
  }

  .case-hero__shape {
    position: absolute;
    top: 18%;
    right: 7%;
    width: clamp(110px, 14vw, 210px);
    aspect-ratio: 1;
    border-radius: 24px;
    background: var(--fuchsia);
    box-shadow: 0 30px 60px -20px rgb(22 22 22 / 0.45);
    transform: rotate(8deg);
  }

  .case-hero__inner {
    position: relative;
    display: grid;
    justify-items: start;
    gap: 24px;
  }

  .case-hero__back {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 14px;
    font-weight: var(--fw-medium);
    text-decoration: none;
  }

  .case-hero__back:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .case-hero__panel {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 720px;
    padding: clamp(26px, 4vw, 44px);
  }

  .case-hero__tagline {
    max-width: 640px;
    font-size: clamp(18px, 1.8vw, 24px);
    font-weight: var(--fw-light);
    line-height: 1.45;
  }

  .case-hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    width: 100%;
    margin-top: 8px;
    padding-top: 20px;
    border-top: 1px solid var(--glass-line);
  }

  .case-hero__meta dt {
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.75;
  }

  .case-hero__meta dd {
    font-size: 15px;
    font-weight: var(--fw-semibold);
  }

  .case-cover {
    position: relative;
    margin-top: -150px;
  }

  .case-cover img {
    width: 100%;
    height: auto;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-lg);
    box-shadow: var(--panel-shadow);
  }

  /* Resumen */
  .case-language {
    padding-top: 16px;
    color: var(--muted);
    font-size: 13px;
    font-style: italic;
    text-align: center;
  }

  .case-summary {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 24px;
    padding-block: 56px 24px;
  }

  .case-summary__item {
    padding: 28px 32px;
  }

  .case-summary__item--brief {
    border-radius: var(--radius-lg);
  }

  .case-summary__item--brief > :not(.brand-surface__tint) {
    position: relative;
  }

  .case-summary__item h2 {
    margin-bottom: 8px;
    color: var(--purple);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-summary__item--brief h2 {
    color: var(--white);
    opacity: 0.8;
  }

  .case-summary__item--brief p {
    font-size: 17px;
    font-weight: var(--fw-medium);
    line-height: 1.55;
  }

  /* Índice + contenido */
  .case-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    padding-bottom: 96px;
  }

  .case-toc {
    position: sticky;
    top: 24px;
    align-self: start;
    padding-top: 48px;
  }

  .case-toc__title {
    margin-bottom: 12px;
    color: var(--muted);
    font-size: 12px;
    font-weight: var(--fw-medium);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-toc ol {
    display: grid;
    gap: 2px;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--line);
  }

  .case-toc a {
    display: flex;
    gap: 10px;
    margin-left: -2px;
    padding: 7px 0 7px 14px;
    border-left: 2px solid transparent;
    color: var(--text);
    font-size: 14px;
    line-height: 1.4;
    text-decoration: none;
    transition:
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .case-toc a span {
    color: var(--fuchsia);
    font-weight: var(--fw-semibold);
  }

  .case-toc a:hover,
  .case-toc a[aria-current='true'] {
    border-color: var(--purple);
    color: var(--purple);
    font-weight: var(--fw-medium);
  }

  /* Contenido largo de cada caso */
  .case-body {
    min-width: 0;
    font-size: 16px;
    line-height: 1.75;
  }

  .case-body :global(p + p) {
    margin-top: 14px;
  }

  .case-body :global(strong) {
    color: var(--ink);
  }

  .case-body :global(figure img),
  .case-body :global(.gallery img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .case-body :global(figcaption) {
    margin-top: 10px;
    color: var(--muted);
    font-size: 13px;
    font-weight: var(--fw-light);
    text-align: center;
  }

  .case-body :global(.gallery) {
    display: grid;
    grid-template-columns: repeat(var(--cols, 3), minmax(0, 1fr));
    align-items: start;
    gap: 16px;
  }

  /* Bulleted lists inside case studies */
  .case-body :global(.list) {
    display: grid;
    gap: 10px;
    padding-left: 22px;
  }

  .case-body :global(.list li::marker) {
    color: var(--fuchsia);
  }

  /* Highlighted statement */
  .case-body :global(.callout) {
    padding: 20px 24px;
    border: 1px solid rgb(201 0 157 / 0.3);
    border-left: 4px solid var(--fuchsia);
    border-radius: var(--radius-md);
    background: var(--fuchsia-12);
    color: var(--ink);
    font-weight: var(--fw-medium);
  }

  /* Cards in a grid: problems, solutions, impact */
  .case-body :global(.cards) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .case-body :global(.card) {
    padding: 22px 22px 24px;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--panel-shadow);
    font-size: 15px;
    line-height: 1.6;
  }

  /* Fuchsia dash above each card title, like the eyebrow */
  .case-body :global(.card h4) {
    margin-bottom: 6px;
    color: var(--purple);
    font-size: 16px;
    font-weight: var(--fw-semibold);
  }

  .case-body :global(.card h4::before) {
    content: '';
    display: block;
    width: 24px;
    height: 3px;
    margin-bottom: 12px;
    border-radius: 3px;
    background: var(--fuchsia);
  }

  /* Numbers from research */
  .case-body :global(.stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 16px;
    padding: 0;
    list-style: none;
  }

  .case-body :global(.stat) {
    padding: 20px;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-md);
    background: var(--purple-06);
    font-size: 14px;
    line-height: 1.5;
  }

  .case-body :global(.stat strong) {
    display: block;
    color: var(--purple);
    font-size: 36px;
    font-weight: var(--fw-bold);
    line-height: 1.1;
  }

  .case-body :global(.stat:nth-child(even) strong) {
    color: var(--fuchsia);
  }

  .case-body :global(.stat span) {
    display: block;
    margin-bottom: 6px;
    color: var(--ink);
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* User persona */
  .case-body :global(.persona) {
    display: grid;
    grid-template-columns: minmax(0, 260px) 1fr;
    align-items: start;
    gap: 28px;
    padding: 24px;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-lg);
    background: var(--white);
    box-shadow: var(--panel-shadow);
  }

  .case-body :global(.persona img) {
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .case-body :global(.persona h4) {
    color: var(--purple);
    font-size: 22px;
    font-weight: var(--fw-semibold);
  }

  .case-body :global(.facts) {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 4px 16px;
    margin-top: 12px;
    font-size: 14px;
  }

  .case-body :global(.facts dt) {
    color: var(--muted);
    font-weight: var(--fw-medium);
  }

  /* Embedded Figma prototype */
  .case-body :global(.prototype) {
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-lg);
  }

  .case-body :global(.prototype iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* Siguiente proyecto */
  .case-next {
    background: var(--purple-06);
  }

  .case-next__link {
    display: grid;
    gap: 6px;
    padding-block: 56px;
    text-decoration: none;
  }

  .case-next__label {
    color: var(--fuchsia);
    font-size: 13px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case-next__name {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    color: var(--purple);
    font-size: clamp(28px, 3.3vw, 44px);
    font-weight: var(--fw-bold);
  }

  .case-next__name svg {
    width: 28px;
    height: 21px;
    transition: transform 0.2s ease;
  }

  .case-next__link:hover .case-next__name svg {
    transform: translateX(8px);
  }

  .case-next__summary {
    max-width: 640px;
    font-weight: var(--fw-light);
  }

  @media (max-width: 1024px) {
    .case-layout {
      grid-template-columns: 1fr;
    }

    .case-toc {
      display: none;
    }
  }

  @media (max-width: 760px) {
    .case-hero {
      padding-bottom: 120px;
    }

    .case-hero__shape {
      top: 24px;
      right: var(--gutter);
      width: 72px;
    }

    .case-hero__inner {
      gap: 16px;
    }

    .case-cover {
      margin-top: -80px;
    }

    .case-summary {
      grid-template-columns: 1fr;
    }

    .case-summary__item {
      padding: 22px;
    }

    .case-body :global(.gallery) {
      grid-template-columns: 1fr;
    }

    .case-body :global(.persona) {
      grid-template-columns: 1fr;
    }

    .case-body :global(.persona img) {
      max-width: 260px;
    }

    .case-body :global(.prototype) {
      aspect-ratio: 9 / 14;
    }
  }
</style>
