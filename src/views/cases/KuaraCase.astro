---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import content from '../../i18n/cases/kuara';
import { getLang } from '../../i18n';
import { media } from '../../i18n/media';

// Shared markup of the case study; the text comes from src/i18n/cases/kuara.ts.
// Screens are exported from the KUARA Figma file (high-fidelity page).
const lang = getLang(Astro.currentLocale);
const c = content[lang];

const cover = media('kuara/cover.jpg', lang);
const onboarding = media('kuara/onboarding.png', lang);
const request = media('kuara/qr-solicitud.png', lang);
const sent = media('kuara/qr-enviado.png', lang);
const branch = media('kuara/sucursal-creada.png', lang);
const dashboard = media('kuara/dashboard.png', lang);

// Kuara's own variables, as defined in Figma (token names stay as in the file)
const colors = [
  { name: 'Purple KUARA/01', hex: '#6A2C8F' },
  { name: 'Purple KUARA/05', hex: '#F4E2FF' },
  { name: 'Blue KUARA/01', hex: '#2DCABE' },
  { name: 'Blue KUARA/05', hex: '#E4F4F3' },
  { name: 'Gray KUARA/01', hex: '#282828' },
  { name: 'Gray KUARA/02', hex: '#464646' },
  { name: 'Gray KUARA/04', hex: '#9E9E9E' },
  { name: 'White KUARA/01', hex: '#FFFFFF' },
];

const typefaces = [
  { family: 'Lexend', role: c.system.panel.typeRoles.heading, sample: 'Subheading/02 · 20/28' },
  { family: 'Poppins', role: c.system.panel.typeRoles.body, sample: 'Body XXL → XS · 24 – 12' },
];

// Instances counted on the high-fidelity page of the file
const components = [
  { name: 'Button', count: 124 },
  { name: 'Input Field', count: 60 },
  { name: 'Menu Item', count: 51 },
  { name: 'Avatar', count: 30 },
  { name: 'Select', count: 24 },
];

const sections = [
  { id: 'reto', title: c.sections.challenge },
  { id: 'sistema', title: c.sections.system },
  { id: 'flujos', title: c.sections.flows },
  { id: 'impacto', title: c.sections.impact },
];
const panel = c.system.panel;
---

<CaseStudy
  slug="kuara"
  name="Kuara"
  tagline={c.tagline}
  cover={cover}
  description={c.description}
  brief={c.brief}
  details={c.details}
  sections={sections}
  note={c.note}
>
  <CaseSection id="reto" number={1} title={c.sections.challenge}>
    <p class="callout">{c.challenge.callout}</p>
    <p set:html={c.challenge.text} />
    <h3>{c.challenge.problemTitle}</h3>
    <ul class="cards">
      {
        c.challenge.problems.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
    <h3>{c.challenge.goalsTitle}</h3>
    <ul class="list">
      {c.challenge.goals.map((goal) => <li>{goal}</li>)}
    </ul>
  </CaseSection>

  <CaseSection id="sistema" number={2} title={c.sections.system}>
    <p>{c.system.text}</p>

    <figure class="kds" aria-labelledby="kds-title">
      <h3 id="kds-title" class="kds__title">
        {panel.title[0]}<strong>{panel.title[1]}</strong>{panel.title[2]}
      </h3>

      <div class="kds__grid">
        <section class="kds__card kds__card--wide" aria-labelledby="kds-colors">
          <h4 id="kds-colors">{panel.colors}</h4>
          <ul class="kds__swatches" translate="no">
            {
              colors.map((color) => (
                <li>
                  <span class="kds__swatch" style={`--swatch: ${color.hex}`} aria-hidden="true" />
                  <span class="kds__name">{color.name}</span>
                  <span class="kds__hex">{color.hex}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="kds__card" aria-labelledby="kds-type">
          <h4 id="kds-type">{panel.type}</h4>
          <ul class="kds__type">
            {
              typefaces.map((face) => (
                <li>
                  <span class="kds__family" translate="no">{face.family}</span>
                  <span class="kds__role">{face.role}</span>
                  <span class="kds__sample" translate="no">{face.sample}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="kds__card" aria-labelledby="kds-components">
          <h4 id="kds-components">{panel.components}</h4>
          <ul class="kds__components" translate="no">
            {
              components.map((item) => (
                <li>
                  <span>{item.name}</span>
                  <strong>{item.count}</strong>
                </li>
              ))
            }
          </ul>
          <p class="kds__usage">{panel.usage}</p>
        </section>
      </div>
    </figure>

    <ul class="cards">
      {
        c.system.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="flujos" number={3} title={c.sections.flows}>
    <p>{c.flows.text}</p>
    <ProcessSteps steps={c.flows.steps} label={c.sections.flows} />

    <h3>{c.flows.onboardingTitle}</h3>
    <p>{c.flows.onboardingText}</p>
    <figure class="screens">
      <Image src={onboarding} alt={c.flows.alts.onboarding} widths={[880, 1728]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>

    <h3>{c.flows.paymentsTitle}</h3>
    <p>{c.flows.paymentsText}</p>
    <div class="gallery screens" style="--cols: 2">
      <Image src={request} alt={c.flows.alts.request} widths={[440, 880, 1512]} sizes="(max-width: 760px) 92vw, 440px" />
      <Image src={sent} alt={c.flows.alts.sent} widths={[440, 880, 1512]} sizes="(max-width: 760px) 92vw, 440px" />
    </div>

    <h3>{c.flows.managementTitle}</h3>
    <p>{c.flows.managementText}</p>
    <figure class="screens">
      <Image src={dashboard} alt={c.flows.alts.dashboard} widths={[880, 1512]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>
    <figure class="screens">
      <Image src={branch} alt={c.flows.alts.branch} widths={[880, 1512]} sizes="(max-width: 1024px) 92vw, 880px" />
    </figure>
  </CaseSection>

  <CaseSection id="impacto" number={4} title={c.sections.impact}>
    <p>{c.impact.text}</p>
    <ul class="cards">
      {
        c.impact.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
    <h3>{c.impact.takeawaysTitle}</h3>
    <ul class="list">
      {c.impact.takeaways.map((item) => <li>{item}</li>)}
    </ul>
  </CaseSection>
</CaseStudy>

<style>
  /* Kuara design system, rebuilt in HTML from the Figma variables. Same frame as the Compass panel:
     portfolio brand gradient outside, white cards with Kuara's own values inside. */
  .kds {
    display: grid;
    gap: clamp(20px, 3vw, 28px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--brand-gradient);
    color: var(--white);
  }

  .kds .kds__title {
    margin: 0;
    color: var(--white);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: var(--fw-regular);
    line-height: 1.2;
  }

  .kds .kds__title strong {
    color: inherit;
    font-weight: var(--fw-bold);
  }

  .kds__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  .kds__card {
    display: grid;
    align-content: start;
    gap: 16px;
    min-width: 0;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--glass-shadow);
    color: var(--text);
  }

  .kds__card--wide {
    grid-column: 1 / -1;
  }

  .kds__card h4 {
    color: var(--purple);
    font-size: 18px;
    font-weight: var(--fw-semibold);
  }

  .kds__swatches {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px 14px;
    padding: 0;
    list-style: none;
  }

  .kds__swatches li {
    display: grid;
    gap: 4px;
    min-width: 0;
  }

  .kds__swatch {
    height: 56px;
    margin-bottom: 6px;
    border-radius: 10px;
    background: var(--swatch);
    box-shadow: inset 0 0 0 1px rgb(22 22 22 / 0.1);
  }

  .kds__name {
    color: var(--ink);
    font-size: 13px;
    font-weight: var(--fw-medium);
    line-height: 1.3;
  }

  .kds__hex {
    color: var(--muted);
    font-size: 12px;
  }

  .kds__type,
  .kds__components {
    display: grid;
    padding: 0;
    list-style: none;
  }

  .kds__type {
    gap: 14px;
  }

  .kds__type li {
    display: grid;
    gap: 2px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }

  .kds__type li:last-child {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .kds__family {
    color: var(--ink);
    font-size: 26px;
    font-weight: var(--fw-semibold);
    line-height: 1.2;
  }

  .kds__role {
    color: var(--purple);
    font-size: 14px;
    font-weight: var(--fw-medium);
  }

  .kds__sample {
    color: var(--muted);
    font-size: 12px;
  }

  .kds__components li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding-block: 9px;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
    font-size: 14px;
    font-weight: var(--fw-medium);
  }

  .kds__components strong {
    color: var(--fuchsia);
    font-size: 16px;
  }

  .kds__usage {
    color: var(--muted);
    font-size: 12px;
    line-height: 1.5;
  }

  /* Product screens have white backgrounds: a hairline and soft shadow keep their edges visible */
  .screens :global(img) {
    border: 1px solid var(--line);
    box-shadow: var(--panel-shadow);
  }

  @media (max-width: 760px) {
    .kds__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .kds__swatches {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .kds {
      padding: 20px 14px 14px;
      border-radius: var(--radius-md);
    }

    .kds .kds__title {
      padding-inline: 4px;
    }

    .kds__card {
      padding: 18px 14px;
      border-radius: 14px;
    }
  }
</style>
