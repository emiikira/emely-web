---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseSection from '../../components/CaseSection.astro';
import content from '../../i18n/cases/pinsxp';
import { getLang } from '../../i18n';
import { media } from '../../i18n/media';
import { counts, primitive, primitiveGroupSize, ramp, semantic } from '../../data/compass';

// Shared markup of the case study; the text comes from src/i18n/cases/pinsxp.ts.
const lang = getLang(Astro.currentLocale);
const c = content[lang];

const cover = media('home/pinsxp.jpg', lang);
const reto1 = media('pinsxp/reto-1.png', lang);
const reto2 = media('pinsxp/reto-2.png', lang);
const reto3 = media('pinsxp/reto-3.png', lang);
const compass1 = media('pinsxp/compass-1.png', lang);
const compass2 = media('pinsxp/compass-2.png', lang);

// Excerpt of Compass, the PinsXP design system. Names and values are read from the Figma export in
// src/data/compass/, so the panel always shows the real tokens. Token names stay in English in both languages.
const primitiveBase = ['white', 'black', 'transparent', 'overlay'].map((name) => ({ name, swatch: primitive(`base/${name}`) }));

const ramps = ['dark cyan lime green', 'gray blue'].map((group) => ({ group, steps: ramp(group) }));

const primitiveGroups = ['spacing', 'width', 'radius', 'opacity', 'blur', 'font'].map((name) => ({
  name,
  size: primitiveGroupSize(name),
}));

const semanticGroups = [
  { path: ['colors', 'brand'], rows: ['primary', 'secondary', 'tertiary'] },
  { path: ['colors', 'background'], rows: ['primary', 'secondary', 'tertiary', 'input', 'overlay'] },
  { path: ['colors / background', 'status'], rows: ['error', 'success', 'info'] },
  { path: ['colors', 'text'], rows: ['primary', 'secondary', 'body', 'placeholder'] },
  { path: ['colors', 'border'], rows: ['default', 'separator'] },
].map((group) => ({
  ...group,
  rows: group.rows.map((name) => {
    const tokenPath = `${group.path.join(' / ').replaceAll(' / ', '/')}/${name}`;
    return { name, ...semantic(tokenPath) };
  }),
}));

// "dark cyan lime green/600" → ["dark cyan lime green/", "600"]
const splitAlias = (alias = '') => {
  const cut = alias.lastIndexOf('/') + 1;
  return [alias.slice(0, cut), alias.slice(cut)];
};
const panel = c.impact.panel;

const sections = [
  { id: 'reto', title: c.sections.challenge },
  { id: 'metodologia', title: c.sections.method },
  { id: 'solucion', title: c.sections.solution },
  { id: 'impacto', title: c.sections.impact },
  { id: 'proximos-pasos', title: c.sections.next },
];
---

<CaseStudy
  slug="pinsxp"
  name="PinsXP"
  tagline={c.tagline}
  cover={cover}
  description={c.description}
  brief={c.brief}
  details={c.details}
  sections={sections}
>
  <CaseSection id="reto" number={1} title={c.sections.challenge}>
    <p set:html={c.challenge.text} />
    <div class="gallery" style="--cols: 3">
      <Image src={reto1} alt={c.challenge.alts[0]} widths={[600, reto1.width]} sizes="(max-width: 760px) 92vw, 300px" />
      <Image src={reto2} alt={c.challenge.alts[1]} />
      <Image src={reto3} alt={c.challenge.alts[2]} />
    </div>
    <h3>{c.challenge.problemTitle}</h3>
    <ul class="cards">
      {
        c.challenge.problems.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="metodologia" number={2} title={c.sections.method}>
    <p>{c.method.text}</p>
    <ol class="cards">
      {
        c.method.steps.map((step) => (
          <li class="card">
            <h4>{step.title}</h4>
            <Fragment set:html={step.text} />
          </li>
        ))
      }
    </ol>
  </CaseSection>

  <CaseSection id="solucion" number={3} title={c.sections.solution}>
    <p>{c.solution.text}</p>
    <div class="gallery" style="--cols: 2">
      <Image src={compass1} alt={c.solution.alts[0]} widths={[728, compass1.width]} sizes="(max-width: 760px) 92vw, 440px" />
      <Image src={compass2} alt={c.solution.alts[1]} widths={[420, compass2.width]} sizes="(max-width: 760px) 92vw, 440px" />
    </div>
    <p class="callout" set:html={c.solution.callout} />
    <ul class="cards">
      {
        c.solution.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
    <h3>{c.solution.code.title}</h3>
    <ul class="list">
      {c.solution.code.items.map((item) => <li>{item}</li>)}
    </ul>
  </CaseSection>

  <CaseSection id="impacto" number={4} title={c.sections.impact}>
    <figure class="tokens" aria-labelledby="tokens-title">
      <header class="tokens__head">
        <p class="tokens__file" translate="no"><span class="tokens__gem" aria-hidden="true"></span>COMPASS · PinsXP Design System</p>
        <h3 id="tokens-title" class="tokens__title">
          {panel.title[0]}<strong>{panel.title[1]}</strong>{panel.title[2]}
        </h3>
      </header>

      <div class="tokens__grid">
        <section class="tokens__card tokens__card--prim" aria-labelledby="tokens-primitives">
          <header class="tokens__card-head">
            <h4 id="tokens-primitives">{panel.primitives.term}</h4>
            <span class="tokens__collection" translate="no">primitives</span>
            <span class="tokens__count">{counts.primitives} {panel.labels.variables}</span>
          </header>
          <p class="tokens__text">{panel.primitives.text}</p>

          <div class="tokens__block">
            <p class="tokens__path" translate="no">primary colors / <b>base</b></p>
            <table class="tokens__table">
              <caption class="visually-hidden">{panel.labels.excerpt}: primary colors / base</caption>
              <thead>
                <tr><th scope="col">{panel.labels.name}</th><th scope="col">{panel.labels.value}</th></tr>
              </thead>
              <tbody translate="no">
                {
                  primitiveBase.map((token) => (
                    <tr>
                      <th scope="row">{token.name}</th>
                      <td>
                        <span class="tokens__value">
                          <span class="tokens__swatch" style={`--swatch: ${token.swatch.css}`} aria-hidden="true" />
                          #{token.swatch.hex}
                          {token.swatch.opacity < 100 && (
                            <span class="tokens__opacity">
                              {token.swatch.opacity}%<span class="visually-hidden"> {panel.labels.opacity}</span>
                            </span>
                          )}
                        </span>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          {
            ramps.map((ramp) => (
              <div class="tokens__block">
                <p class="tokens__path" translate="no">
                  primary colors / <b>{ramp.group}</b>
                </p>
                <ol class="tokens__ramp" aria-label={`primary colors / ${ramp.group} · ${panel.labels.scale}`} translate="no">
                  {ramp.steps.map(({ step, swatch }) => (
                    <li title={`${ramp.group}/${step} · #${swatch.hex}`}>
                      <span class="tokens__ramp-chip" style={`--swatch: ${swatch.css}`} aria-hidden="true" />
                      <span class="tokens__ramp-step">{step}</span>
                      <span class="visually-hidden">#{swatch.hex}</span>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }

          <div class="tokens__block">
            <p class="tokens__path">{panel.labels.groups}</p>
            <ul class="tokens__groups" translate="no">
              {primitiveGroups.map(({ name, size }) => <li>{name} <span>{size}</span></li>)}
            </ul>
          </div>
        </section>

        <section class="tokens__card" aria-labelledby="tokens-semantics">
          <header class="tokens__card-head">
            <h4 id="tokens-semantics">{panel.semantics.term}</h4>
            <span class="tokens__collection" translate="no">semantics</span>
            <span class="tokens__count">{counts.semantics} {panel.labels.variables}</span>
          </header>
          <p class="tokens__text">{panel.semantics.text}</p>

          <div class="tokens__scroll">
            <table class="tokens__table tokens__table--modes">
              <caption class="visually-hidden">{panel.labels.excerpt}: semantics</caption>
              <thead>
                <tr>
                  <th scope="col">{panel.labels.name}</th>
                  <th scope="col">{panel.labels.light}</th>
                  <th scope="col" class="is-dark">{panel.labels.dark}</th>
                </tr>
              </thead>
              {
                semanticGroups.map((group) => (
                  <tbody translate="no">
                    <tr class="tokens__group-row">
                      <th scope="colgroup" colspan="3">
                        {group.path[0]} / <b>{group.path[1]}</b>
                      </th>
                    </tr>
                    {group.rows.map((row) => (
                      <tr>
                        <th scope="row">{row.name}</th>
                        {[row.light, row.dark].map((value, index) => (
                          <td class:list={{ 'is-dark': index === 1 }} title={`#${value.hex}${value.opacity < 100 ? ` · ${value.opacity}%` : ''}`}>
                            <span class="tokens__value">
                              <span class="tokens__swatch" style={`--swatch: ${value.css}`} aria-hidden="true" />
                              <span class="tokens__alias">
                                <span class="tokens__prefix">{splitAlias(value.alias)[0]}</span>
                                {splitAlias(value.alias)[1]}
                                <span class="visually-hidden"> #{value.hex}</span>
                              </span>
                            </span>
                          </td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                ))
              }
            </table>
          </div>
        </section>
      </div>
      <figcaption class="visually-hidden">{c.impact.alt}</figcaption>
    </figure>
    <ul class="cards">
      {
        c.impact.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>

  <CaseSection id="proximos-pasos" number={5} title={c.sections.next}>
    <h3>{c.next.title}</h3>
    <p>{c.next.text}</p>
    <ul class="cards">
      {
        c.next.cards.map((card) => (
          <li class="card">
            <h4>{card.title}</h4>
            <Fragment set:html={card.text} />
          </li>
        ))
      }
    </ul>
  </CaseSection>
</CaseStudy>

<style>
  /* Compass variables, rebuilt in HTML from the Figma panel so the tables translate and stay sharp.
     Brand frame (global.css tokens) around the real Compass values; an ink column previews Dark mode. */
  .tokens {
    display: grid;
    gap: clamp(20px, 3vw, 28px);
    padding: clamp(24px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--brand-gradient);
    color: var(--white);
  }

  .tokens__head {
    display: grid;
    gap: 10px;
  }

  .tokens__file {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 12px;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.85;
  }

  .tokens__gem {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    background: var(--white);
    transform: rotate(45deg);
  }

  .tokens .tokens__title {
    margin: 0;
    color: var(--white);
    font-size: clamp(24px, 3vw, 32px);
    font-weight: var(--fw-regular);
    line-height: 1.2;
  }

  .tokens .tokens__title strong {
    color: inherit;
    font-weight: var(--fw-bold);
  }

  .tokens__grid {
    display: grid;
    gap: 20px;
  }

  .tokens__card {
    display: grid;
    gap: 18px;
    min-width: 0;
    padding: clamp(20px, 3vw, 28px);
    border: 1px solid var(--panel-line);
    border-radius: var(--radius-md);
    background: var(--white);
    box-shadow: var(--glass-shadow);
    color: var(--text);
  }

  .tokens__card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }

  .tokens__card-head h4 {
    margin-right: auto;
    color: var(--purple);
    font-size: 20px;
    font-weight: var(--fw-semibold);
    line-height: 1.3;
  }

  .tokens__collection,
  .tokens__count {
    padding: 3px 10px;
    border-radius: 999px;
    font-size: 12px;
    font-weight: var(--fw-medium);
    line-height: 1.5;
  }

  .tokens__collection {
    background: var(--purple-06);
    color: var(--purple);
  }

  .tokens__count {
    background: var(--fuchsia-12);
    color: var(--fuchsia);
  }

  .tokens__text {
    font-size: 15px;
    line-height: 1.65;
  }

  .tokens__block {
    display: grid;
    gap: 10px;
  }

  .tokens .tokens__path,
  .tokens__group-row th {
    color: var(--muted);
    font-size: 12px;
    font-weight: var(--fw-regular);
    letter-spacing: 0.02em;
  }

  .tokens__path b,
  .tokens__group-row b {
    color: var(--ink);
    font-weight: var(--fw-semibold);
  }

  /* Tables: hairline rows like the Figma panel, brand type */
  .tokens__scroll {
    overflow-x: auto;
    border: 1px solid var(--line);
    border-radius: 12px;
  }

  .tokens__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    line-height: 1.4;
    text-align: left;
  }

  .tokens__block > .tokens__table {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    border-collapse: separate;
    border-spacing: 0;
  }

  .tokens__table :is(th, td) {
    padding: 10px 14px;
    border-top: 1px solid var(--line);
    vertical-align: middle;
  }

  .tokens__table thead th {
    border-top: 0;
    background: var(--surface);
    color: var(--ink);
    font-size: 12px;
    font-weight: var(--fw-semibold);
  }

  .tokens__table tbody th {
    color: var(--ink);
    font-weight: var(--fw-medium);
    white-space: nowrap;
  }

  .tokens__group-row th {
    padding-top: 14px;
    background: var(--purple-06);
  }

  .tokens__table--modes th:first-child {
    width: 22%;
  }

  /* Dark mode column, so the switch between modes reads at a glance */
  .tokens__table .is-dark {
    background: var(--ink);
    color: rgb(255 255 255 / 0.86);
  }

  .tokens__table thead .is-dark {
    background: var(--ink);
    color: var(--white);
  }

  .tokens__table td.is-dark {
    border-top-color: rgb(255 255 255 / 0.12);
  }

  .tokens__value {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
  }

  .tokens__prefix {
    opacity: 0.6;
  }

  .tokens__alias {
    white-space: nowrap;
  }

  /* The checkerboard shows through translucent values (overlay, transparent) */
  .tokens__swatch {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: 5px;
    background:
      linear-gradient(var(--swatch), var(--swatch)),
      repeating-conic-gradient(var(--line) 0% 25%, var(--white) 0% 50%) 0 0 / 8px 8px;
    box-shadow: inset 0 0 0 1px rgb(22 22 22 / 0.12);
  }

  .is-dark .tokens__swatch {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18);
  }

  .tokens__opacity {
    padding: 1px 8px;
    border-radius: 999px;
    background: var(--surface);
    color: var(--muted);
    font-size: 11px;
    font-weight: var(--fw-medium);
  }

  /* gray blue 50–950 as one continuous ramp */
  .tokens__ramp {
    display: grid;
    grid-template-columns: repeat(11, minmax(0, 1fr));
    gap: 3px;
    padding: 0;
    list-style: none;
  }

  .tokens__ramp li {
    display: grid;
    gap: 6px;
    text-align: center;
  }

  .tokens__ramp-chip {
    height: 36px;
    border-radius: 5px;
    background:
      linear-gradient(var(--swatch), var(--swatch)),
      repeating-conic-gradient(var(--line) 0% 25%, var(--white) 0% 50%) 0 0 / 10px 10px;
    box-shadow: inset 0 0 0 1px rgb(22 22 22 / 0.08);
  }

  .tokens__ramp-step {
    color: var(--muted);
    font-size: 11px;
    font-weight: var(--fw-medium);
  }

  .tokens__groups {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    padding: 0;
    list-style: none;
  }

  .tokens__groups li {
    padding: 5px 12px;
    border: 1px solid var(--panel-line);
    border-radius: 8px;
    color: var(--ink);
    font-size: 13px;
    font-weight: var(--fw-medium);
  }

  .tokens__groups span {
    margin-left: 4px;
    color: var(--fuchsia);
  }

  /* Primitives: base table, ramps and groups flow into two columns when there is room */
  .tokens__card--prim {
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    align-items: start;
    gap: 22px 28px;
  }

  .tokens__card--prim > :is(header, .tokens__text) {
    grid-column: 1 / -1;
  }

  @media (max-width: 560px) {
    .tokens__prefix {
      display: block;
      font-size: 11px;
      white-space: normal;
    }

    .tokens__value {
      align-items: flex-start;
    }

    .tokens__value {
      gap: 7px;
      font-size: 12px;
    }

    /* Each token becomes a two-line row: its name, then Light and Dark side by side */
    .tokens__scroll {
      overflow: hidden;
    }

    .tokens__table--modes,
    .tokens__table--modes :is(thead, tbody) {
      display: block;
    }

    .tokens__table--modes tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tokens__table--modes thead th:first-child {
      display: none;
    }

    .tokens__table--modes :is(.tokens__group-row th, tbody th[scope='row']) {
      grid-column: 1 / -1;
      width: auto;
    }

    .tokens__table--modes tbody th[scope='row'] {
      padding-bottom: 4px;
    }

    .tokens__table--modes tbody td {
      border-top: 0;
    }

    .tokens__ramp {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .tokens__table :is(th, td) {
      padding: 9px 8px;
    }
  }
</style>
